  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DirectedNarrator
  channels:
  - channelName: HallwayForward
    priority: 6
    conditions:
    - variableKey: HallwayForward
      comparison: 0
      value: 1
    narrations:
    - text: Attention, please.
      clip: {fileID: 8300000, guid: 3aa4888cb65a648aaabdd5a821c5540d, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
    - text: I will escort you through the hallways.
      clip: {fileID: 8300000, guid: 1d63b4702810248cbbfc474ebf891d1b, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
    - text: 'Do not talk to anyone in the hallways. Weird people around here. '
      clip: {fileID: 8300000, guid: ce258567f36b24ba99a2879988ccbff8, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
    - text: 'At the end of the hallway take a left then a right. '
      clip: {fileID: 8300000, guid: 8ecb935c093cb49ad8ba83e9e1dd0131, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
    - text: fffff
      clip: {fileID: 0}
      isImportant: 1
      destinationIfUnsaid: RightJunctionForward
    returnTransitions: []
    returnLinesCount: 0
    loopReturnTransitions: 0
  - channelName: HallwayBackward
    priority: 6
    conditions:
    - variableKey: HallwayBackward
      comparison: 0
      value: 1
    narrations:
    - text: b
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    - text: bb
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    - text: bbb
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    - text: bbbb
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
  - channelName: RightJunctionForward
    priority: 6
    conditions:
    - variableKey: RightJunctionForward
      comparison: 0
      value: 1
    narrations:
    - text: Attention, please.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    - text: ff
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    - text: fff
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    - text: ffff
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
  transitions:
  - fromChannel: HallwayBackward
    toChannel: HallwayForward
    narrations:
    - text: Good. Where were we? Ah, yes!
      clip: {fileID: 8300000, guid: 566d9b01bbe2146e8b6f3b1e9db96085, type: 3}
    linesPerSwitch: 1
    loop: 1
  idleNarrations:
  - text: Are you gonna move or what?
    clip: {fileID: 8300000, guid: 2bd873523d1b6438ab3238bf8bc7c8f1, type: 3}
