  - component: {fileID: 592384909}
  - component: {fileID: 592384908}
  m_Layer: 0
  m_Name: DirectedNarrator
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &592384908
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 592384907}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bf653261c5c445c3ac5ff1a4e9a835a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DirectedNarrator
  channels:
  - channelName: HallwayForward
    priority: 6
    conditions:
    - variableKey: HallwayForward
      comparison: 0
      value: 1
    narrations:
    - text: Test... Test...
      clip: {fileID: 8300000, guid: c68ad476a4d784118ac30d8cf7645d6c, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 1
    - text: Attention, please!
      clip: {fileID: 8300000, guid: b2d0c222a250b446da16fe61f9f04f5f, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Welcome to our humble hotel.
      clip: {fileID: 8300000, guid: c00f69cbe51fc42e8b44fd0bfe1b156c, type: 3}
      isImportant: 0
      destinationIfUnsaid: RightJunctionForward
      discardOnInterrupt: 0
    - text: I will escort you through the speaker, so you don't get lost. Or bored.
        Nobody gets bored in our hotel!
      clip: {fileID: 8300000, guid: 571edb82f39af4f7ba7c7dc6ba31eb06, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Please proceed to the end of the hallway. You're doing great.
      clip: {fileID: 8300000, guid: 119c7f2bddf944f0682da78b936d265a, type: 3}
      isImportant: 1
      destinationIfUnsaid: RightJunctionForward
      discardOnInterrupt: 0
    - text: You know the way by now.
      clip: {fileID: 8300000, guid: 3eea1dfef8f8a4d8d857da18911669c9, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: End of the hallway. Then take a left.
      clip: {fileID: 8300000, guid: d9fe0db6399574667b16a37e910b25aa, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
  - channelName: HallwayBackward
    priority: 6
    conditions:
    - variableKey: HallwayBackward
      comparison: 0
      value: 1
    narrations:
    - text: Hold on. Why are you going back?
      clip: {fileID: 8300000, guid: 72f307acc1fe2408f83222944ace6511, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: No. No. You're not supposed to go back.
      clip: {fileID: 8300000, guid: 43297bd2c7e734992a227688cf8d2483, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Turn around!
      clip: {fileID: 8300000, guid: 39d60843df50b48db91efb2f75994d77, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Come on, dude. I told you a million times. Wrong way!
      clip: {fileID: 8300000, guid: 4920f56b8b3dc48169ac19a9f6a9ba3b, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
  - channelName: EmptyRoom1
    priority: 6
    conditions:
    - variableKey: EmptyRoomNarrative1
      comparison: 0
      value: 1
    narrations:
    - text: This is just an empty room.
      clip: {fileID: 8300000, guid: b00b50805e8944ad68b7b2403a618afe, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: There is nothing here.
      clip: {fileID: 8300000, guid: 3074ed9d0c6bd47c48d35695dbc516fd, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You should head back to the hallway.
      clip: {fileID: 8300000, guid: b57ee554455c54fdfa2c343a746f396c, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: What are you looking at? It's empty!
      clip: {fileID: 8300000, guid: 450620554f95a4c838bd8161b7f3ca9c, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
  - channelName: RightJunctionForward
    priority: 6
    conditions:
    - variableKey: RightJunctionForward
      comparison: 0
      value: 1
    narrations:
    - text: Ah! Look at you!
      clip: {fileID: 8300000, guid: 6e14f75895b43416bb034a2963841c90, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You know your way around the hotel better than me.
      clip: {fileID: 8300000, guid: 2e4dd926a77334c56bc137e9fa74bab6, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: All you have to do is take a right at the end of the hallway.
      clip: {fileID: 8300000, guid: 92833f74e835d4ad6a1f1d64cde962e1, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Go on. Room 8 is right waiting.
      clip: {fileID: 8300000, guid: 8236314d228cd4624ab99dbda28f2943, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
  - channelName: RightJunctionBackward
    priority: 6
    conditions:
    - variableKey: RightJunctionBackward
      comparison: 0
      value: 1
    narrations:
    - text: This is an empty room.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: There is nothing here.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You should go back to the hallway.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: What are you looking at? It's empty!
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
  - channelName: RightJunctionBackward
    priority: 6
    conditions:
    - variableKey: RightJunctionBackward
      comparison: 0
      value: 1
    - variableKey: BackwardCount
      comparison: 1
      value: 3
    narrations:
    - text: You just love going backward. Don't you?
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: There is nothing there.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Go back.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: What are you looking at? It's empty!
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
  transitions:
  - fromChannel: HallwayBackward
    toChannel: HallwayForward
    narrations:
    - text: Good. Where were we? Ah, yes!
      clip: {fileID: 8300000, guid: 7900182c1b1c048c383c87951d339a91, type: 3}
    - text: There you are. As I was saying...
      clip: {fileID: 8300000, guid: 06cc10e3e58bc49c2adef913bbd9feae, type: 3}
    - text: Alright, back to it!
      clip: {fileID: 8300000, guid: df1ccb77ff59247e7afcce7386db40a0, type: 3}
    - text: Okay... Before you so rudely interrupted me... I was saying...
      clip: {fileID: 8300000, guid: 12daea20196054e0d9acd6b0b71206ef, type: 3}
    linesPerSwitch: 1
    loop: 1
  - fromChannel: EmptyRoom1
    toChannel: HallwayForward
    narrations:
    - text: Alright, back to it!
      clip: {fileID: 8300000, guid: df1ccb77ff59247e7afcce7386db40a0, type: 3}
    - text: There you are. As I was saying...
      clip: {fileID: 8300000, guid: 06cc10e3e58bc49c2adef913bbd9feae, type: 3}
    - text: Good. Where were we? Ah, yes!
      clip: {fileID: 8300000, guid: 7900182c1b1c048c383c87951d339a91, type: 3}
    - text: Okay... Before you so rudely interrupted me... I was saying...
      clip: {fileID: 8300000, guid: 12daea20196054e0d9acd6b0b71206ef, type: 3}
    linesPerSwitch: 1
    loop: 1
  idleNarrations:
  - text: Are you gonna move?
    clip: {fileID: 8300000, guid: b69e51b23a72949fbbd83829122a99f5, type: 3}
  - text: You're not gonna just stand there, are you?
    clip: {fileID: 8300000, guid: 46b2e4edb51024eb6a924f1731992260, type: 3}
  - text: You know this would be boring if you don't do anything?
    clip: {fileID: 8300000, guid: 28ba010a22d22403d88dc4749a63124f, type: 3}
  - text: Move, please!
    clip: {fileID: 8300000, guid: 8d34f4c5112eb43d5a49bf0d728eece1, type: 3}
  - text: Move, damn you!
    clip: {fileID: 8300000, guid: 6f70fc38145f0499db7c574a19d84dcb, type: 3}
  - text: Security! I'll call security if you don't move.
    clip: {fileID: 8300000, guid: d86c8733566804baf8352908d200f8fa, type: 3}
  - text: You're lucky the security guy is nowhere to be found. Move...or I'll come
      get you myself.
    clip: {fileID: 8300000, guid: 8911a2703da5c44bf879dde4b6916d75, type: 3}
  lineDuration: 4
  lineGap: 0.5
  idlePriority: 1
  idleThreshold: 10
  moveToResumeTime: 2.5
  movementGraceWindow: 0.3
  loopIdle: 1
  playerTransform: {fileID: 400704758}
