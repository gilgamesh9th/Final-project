  - channelName: RightJunctionBackward
    priority: 6
    conditions:
    - variableKey: RightJunctionBackward
      comparison: 0
      value: 1
    narrations:
    - text: This is an empty room.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: There is nothing here.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You should go back to the hallway.
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: What are you looking at? It's empty!
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
