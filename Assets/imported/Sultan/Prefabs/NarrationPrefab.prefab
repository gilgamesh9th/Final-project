    disableIdleOnComplete: 0
  - channelName: LoopB2
    priority: 7
    conditions:
    - variableKey: LoopB2
      comparison: 0
      value: 1
    narrations:
    - text: Whoah whoah! Hold on. Stand still.
      clip: {fileID: 8300000, guid: b22dc60056e724ee095a783b0c7d885a, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Can you step backwards?
      clip: {fileID: 8300000, guid: c3724b19fbf484f3d91a7707a2c54078, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Another one please.
      clip: {fileID: 8300000, guid: 1dc2e51acfdf14eb6a6ded81af5522cc, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 1
    disableChannelsOnComplete: []
    disableAllTransitionsOnComplete: 0
    disableTransitionsOnComplete: []
    disableIdleOnComplete: 0
  - channelName: LoopSolved
    priority: 7
    conditions:
    - variableKey: LoopSolved
      comparison: 0
      value: 1
    narrations:
    - text: Aha!
      clip: {fileID: 8300000, guid: cb4b0fa1b39e942c1b96bf731b84fa07, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: That's why you were stuck.
      clip: {fileID: 8300000, guid: c8c3ef496bbb746628a8de2785e20949, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Now you should be unstuck.
      clip: {fileID: 8300000, guid: f01f0a654b2bd4b6fb943a716e7b9de0, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
    disableChannelsOnComplete: []
    disableAllTransitionsOnComplete: 0
    disableTransitionsOnComplete: []
    disableIdleOnComplete: 0
  transitions:
  - label: 
    fromChannel: HallwayBackward
    toChannel: HallwayForward
    narrations:
    - text: Good. Where were we? Ah, yes!
      clip: {fileID: 8300000, guid: 7900182c1b1c048c383c87951d339a91, type: 3}
      mustComplete: 0
    - text: There you are. As I was saying...
      clip: {fileID: 8300000, guid: 06cc10e3e58bc49c2adef913bbd9feae, type: 3}
      mustComplete: 0
    - text: Alright, back to it!
      clip: {fileID: 8300000, guid: df1ccb77ff59247e7afcce7386db40a0, type: 3}
      mustComplete: 0
    - text: Okay... Before you so rudely interrupted me... I was saying...
      clip: {fileID: 8300000, guid: 12daea20196054e0d9acd6b0b71206ef, type: 3}
      mustComplete: 0
    linesPerSwitch: 1
    loop: 1
  - label: 
    fromChannel: EmptyRoom1
    toChannel: HallwayForward
    narrations:
    - text: Alright, back to it!
      clip: {fileID: 8300000, guid: df1ccb77ff59247e7afcce7386db40a0, type: 3}
      mustComplete: 0
    - text: There you are. As I was saying...
      clip: {fileID: 8300000, guid: 06cc10e3e58bc49c2adef913bbd9feae, type: 3}
      mustComplete: 0
    - text: Good. Where were we? Ah, yes!
      clip: {fileID: 8300000, guid: 7900182c1b1c048c383c87951d339a91, type: 3}
      mustComplete: 0
    - text: Okay... Before you so rudely interrupted me... I was saying...
      clip: {fileID: 8300000, guid: 12daea20196054e0d9acd6b0b71206ef, type: 3}
      mustComplete: 0
    linesPerSwitch: 1
    loop: 1
  idleNarrations:
  - text: Are you gonna move?
    clip: {fileID: 8300000, guid: b69e51b23a72949fbbd83829122a99f5, type: 3}
    mustComplete: 0
  - text: You're not gonna just stand there, are you?
    clip: {fileID: 8300000, guid: 46b2e4edb51024eb6a924f1731992260, type: 3}
    mustComplete: 0
  - text: You know this would be boring if you don't do anything?
    clip: {fileID: 8300000, guid: 28ba010a22d22403d88dc4749a63124f, type: 3}
    mustComplete: 0
  - text: Move, please!
    clip: {fileID: 8300000, guid: 8d34f4c5112eb43d5a49bf0d728eece1, type: 3}
    mustComplete: 0
  - text: Move, damn you!
    clip: {fileID: 8300000, guid: 6f70fc38145f0499db7c574a19d84dcb, type: 3}
    mustComplete: 0
  - text: Security! I'll call security if you don't move.
    clip: {fileID: 8300000, guid: d86c8733566804baf8352908d200f8fa, type: 3}
    mustComplete: 0
  - text: You're lucky the security guy is nowhere to be found. Move...or I'll come
      get you myself.
    clip: {fileID: 8300000, guid: 8911a2703da5c44bf879dde4b6916d75, type: 3}
    mustComplete: 0
  lineDuration: 4
