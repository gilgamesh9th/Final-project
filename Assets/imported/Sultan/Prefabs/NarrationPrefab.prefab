      comparison: 0
      value: 1
    narrations:
    - text: Test... Test...
      clip: {fileID: 8300000, guid: c68ad476a4d784118ac30d8cf7645d6c, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 1
    - text: Attention, please!
      clip: {fileID: 8300000, guid: b2d0c222a250b446da16fe61f9f04f5f, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 1
    - text: Welcome to our humble hotel.
      clip: {fileID: 8300000, guid: c00f69cbe51fc42e8b44fd0bfe1b156c, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: I will escort you through the speaker, so you don't get lost. Or bored.
        Nobody gets bored in our hotel!
      clip: {fileID: 8300000, guid: 571edb82f39af4f7ba7c7dc6ba31eb06, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Please proceed to the end of the hallway. You're doing great.
      clip: {fileID: 8300000, guid: 119c7f2bddf944f0682da78b936d265a, type: 3}
      isImportant: 1
      destinationIfUnsaid: RightJunctionForward
      discardOnInterrupt: 0
    - text: Ah! Look at you!
      clip: {fileID: 8300000, guid: 6e14f75895b43416bb034a2963841c90, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You know your way around the hotel better than me.
      clip: {fileID: 8300000, guid: 2e4dd926a77334c56bc137e9fa74bab6, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: All you have to do is take a right at the end of the hallway.
      clip: {fileID: 8300000, guid: 92833f74e835d4ad6a1f1d64cde962e1, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Go on. Room 8 is waiting.
      clip: {fileID: 8300000, guid: 8236314d228cd4624ab99dbda28f2943, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
