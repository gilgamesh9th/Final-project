  - channelName: HallwayBackward
    priority: 6
    conditions:
    - variableKey: HallwayBackward
      comparison: 0
      value: 1
    - variableKey: BackwardCount
      comparison: 4
      value: 100
    narrations:
    - text: Hold on. Why are you going back?
      clip: {fileID: 8300000, guid: 72f307acc1fe2408f83222944ace6511, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: No. No. You're not supposed to go back.
      clip: {fileID: 8300000, guid: 43297bd2c7e734992a227688cf8d2483, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Turn around!
      clip: {fileID: 8300000, guid: 39d60843df50b48db91efb2f75994d77, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: Come on, dude. I told you a million times. Wrong way!
      clip: {fileID: 8300000, guid: 4920f56b8b3dc48169ac19a9f6a9ba3b, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You just LOVE going back, don't you?
      clip: {fileID: 8300000, guid: 9837f269a5f7c442b9f3c78c6f851f6e, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: 'You understand English right? Like words? '
      clip: {fileID: 8300000, guid: 0f70ae84a96a04dacb542c2aff3dc8d8, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: You know what. Go back as much as you like.
      clip: {fileID: 8300000, guid: f2177a8280aab47ea9bdff902f840b57, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 1
    - text: Let a mantis eat you for all I care.
      clip: {fileID: 8300000, guid: 387184ce7413849a2a5e73c7ee008724, type: 3}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    returnTransitions: []
    returnLinesCount: 1
    loopReturnTransitions: 0
    loopLastLine: 0
    disableChannelsOnComplete: []
    disableAllTransitionsOnComplete: 0
    disableTransitionsOnComplete: []
    disableIdleOnComplete: 0
