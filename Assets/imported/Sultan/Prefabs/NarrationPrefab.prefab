    - variableKey: BackwardCount
      comparison: 1
      value: 3
    narrations:
    - text: You just love going backward. Don't you?
      clip: {fileID: 0}
      isImportant: 0
      destinationIfUnsaid: 
      discardOnInterrupt: 0
    - text: There is nothing there.
      clip: {fileID: 0}
      isImportant: 0
